# Copy to .env. Never commit .env.
# Only needed for the providers you enable in config/jarvis.toml.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Log filter for the backend (tracing EnvFilter syntax).
RUST_LOG=info,jarvis_api=debug,jarvis_bridge_client=debug

# Session signing key, at least 32 random bytes. Generate one with:
#   pwsh -c "[Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }) -as [byte[]])"
JARVIS_JWT_SECRET=
