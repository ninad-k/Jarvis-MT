# Copy to .env. Never commit .env.
# Only needed for the providers you enable in config/jarvis.toml.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Log filter for the backend (tracing EnvFilter syntax).
RUST_LOG=info,jarvis_api=debug,jarvis_bridge_client=debug

# Session signing key, at least 32 random bytes (the server will not start with login enabled
# and no usable key). Generate one with:
#   pwsh -c "$b = [byte[]]::new(48); [Security.Cryptography.RandomNumberGenerator]::Fill($b); [Convert]::ToBase64String($b)"
# It also encrypts the stored authenticator (TOTP) secrets: after changing it, run
# `jarvis-api user reset-totp <name>` for every user. Needed by `jarvis-api user ...` too.
JARVIS_JWT_SECRET=
