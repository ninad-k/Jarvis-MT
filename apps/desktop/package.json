{
	"name": "jarvis-desktop",
	"private": true,
	"version": "0.1.0",
	"description": "Jarvis MT desktop shell (Tauri 2)",
	"license": "Apache-2.0",
	"type": "module",
	"scripts": {
		"tauri": "tauri",
		"dev": "tauri dev",
		"dev:web": "tauri dev --config src-tauri/tauri.dev-web.conf.json",
		"build": "tauri build",
		"build:debug": "tauri build --debug",
		"icons": "node scripts/make-icon.mjs && tauri icon assets/icon-source.png"
	},
	"devDependencies": {
		"@tauri-apps/cli": "2.12.4",
		"sharp": "0.35.5"
	},
	"engines": {
		"node": ">=22"
	}
}
